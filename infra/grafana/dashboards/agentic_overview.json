{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Agentic Investing - Overview",
  "uid": "agentic-overview",
  "schemaVersion": 39,
  "version": 2,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Kill switch activo",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "agentic_kill_switch_active", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Oportunidades por fuente (rate 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum by (agent_source) (rate(agentic_opportunities_total[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Decisiones (OPERATE vs NO_OPERATE)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (decision) (rate(agentic_decisions_total[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ordenes por estado",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum by (status) (rate(agentic_orders_total[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia senal -> orden (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(agentic_signal_to_order_seconds_bucket[5m])) by (le))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rechazos del Risk Filter (rate 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(agentic_risk_rejections_total[5m])", "refId": "A" }
      ]
    },
    {
      "type": "gauge",
      "title": "P&L no realizado (% equity)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "yellow","value": -1   },
              { "color": "green", "value": 0    }
            ]
          }
        }
      },
      "targets": [
        { "expr": "agentic_pnl_unrealized_pct * 100", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Posiciones abiertas",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 24 },
      "targets": [
        { "expr": "agentic_open_positions", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Pérdidas consecutivas",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 2    },
              { "color": "red",    "value": 4    }
            ]
          }
        }
      },
      "targets": [
        { "expr": "agentic_consecutive_losses", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stop-loss faltantes (acumulado)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        { "expr": "agentic_missing_stop_loss_total", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Eventos de monitorización por tipo y severidad (rate 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "targets": [
        {
          "expr": "sum by (event_type, severity) (rate(agentic_monitoring_events_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
