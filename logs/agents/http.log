{"event": "http_response", "method": "POST", "url": "https://api.apify.com/v2/acts/danek~twitter-scraper/run-sync-get-dataset-items", "status": 201, "elapsed_ms": 6650, "attempt": 1, "response_body": "[{\n  \"type\": \"tweet\",\n  \"tweet_id\": \"2087088661506437369\",\n  \"screen_name\": \"harjitrathore\",\n  \"bookmarks\": 0,\n  \"favorites\": 0,\n  \"created_at\": \"Tue Aug 11 08:08:07 +0000 2026\",\n  \"text\": \"$INTC plans to sell 15 billion dollars in new stock, its first public share sale since the company listed back in 1971.\\n\\nThe raise is earmarked for general corporate purposes, but the framing is clear: fund the comeback and grab a share of the AI buildout through real world AI applications and purpose built silicon.\\n\\nA 55 year old company going back to equity markets for the first time says something about how capital intensive this AI cycle has become, even for legacy chipmakers trying to stay relevant.\\n\\n#Intel #chips \\n\\nhttps://t.co/7p2gUQjEhA\",\n  \"lang\": \"en\",\n  \"display_text_range\": [\n    0,\n    277\n  ],\n  \"source\": \"<a href=\\\"http://twitter.com/download/iphone\\\" rel=\\\"nofollow\\\">Twitter for iPhone</a>\",\n  \"quotes\": 0,\n  \"sensitive\": null,\n  \"replies\": 0,\n  \"conversation_id\": \"2087088661506437369\",\n  \"retweets\": 0,\n  \"views\": \"4\",\n  \"entities\": {\n    \"hashtags\": [\n      {\n        \"indices\": [\n          511,\n          517\n        ],\n        \"text\": \"Intel\"\n      },\n      {\n        \"indices\": [\n          518,\n          524\n        ],\n        \"text\": \"chips\"\n      }\n    ],\n    \"symbols\": [\n      {\n        \"indices\": [\n          0,\n          5\n        ],\n        \"tag\": {\n          \"info\": {\n            \"info\": {\n              \"name\": \"Intel Corp\",\n              \"ticker\": \"INTC\"\n            }\n          }\n        },\n        \"text\": \"INTC\"\n      }\n    ],\n    \"urls\": [\n      {\n        \"display_url\": \"bloomberg.com/new