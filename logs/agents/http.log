",\n    \"created_at\": \"Sun Jul 16 20:44:44 +0000 2023\",\n    \"description\": null,\n    \"rest_id\": \"1680679836874842114\",\n    \"followers_count\": 236,\n    \"favorites_count\": 28379,\n    \"avatar\": \"https://pbs.twimg.com/profile_images/2058692017022971904/HHeiGzov_normal.jpg\",\n    \"url\": null,\n    \"cover_image\": null,\n    \"verified_type\": null,\n    \"verified\": false,\n    \"friends_count\": null,\n    \"location\": \"\"\n  },\n  \"media\": [],\n  \"in_reply_to_screen_name\": \"MEXC\",\n  \"in_reply_to_status_id_str\": \"2087086622122664098\",\n  \"in_reply_to_user_id_str\": \"978566222282444800\"\n},\n{\n  \"type\": \"tweet\",\n  \"tweet_id\": \"2087099458378997982\",\n  \"screen_name\": \"MitchellZe19163\",\n  \"bookmarks\": 0,\n  \"favorites\": 0,\n  \"created_at\": \"Tue Aug 11 08:51:01 +0000 2026\",\n  \"text\": \"Silently stacking while everyone sleeps on the North. Maple syrup and serious bags 🍁\\n\\n#momsonn #BBNaija\\n\\n$NEM\",\n  \"lang\": \"en\",\n  \"display_text_range\": [\n    0,\n    109\n  ],\n  \"source\": \"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\n  \"quotes\": 0,\n  \"sensitive\": null,\n  \"replies\": 0,\n  \"conversation_id\": \"2087099458378997982\",\n  \"retweets\": 0,\n  \"views\": \"133\",\n  \"entities\": {\n    \"hashtags\": [\n      {\n        \"indices\": [\n          86,\n          94\n        ],\n        \"text\": \"momsonn\"\n      },\n      {\n        \"indices\": [\n          95,\n          103\n        ],\n        \"text\": \"BBNaija\"\n      }\n    ],\n    \"symbols\": [\n      {\n        \"indices\": [\n          105,\n          109\n        ],\n        \"tag\": {\n          \"info\": {\n            \"info\": {\n              \"name\": \"Newmont Corporation\",\n              \"ticker\": \"NEM\"\n            }\n          }\n        },\n        \"text\": \"NEM\"\n      }\n    ],\n    \"timestamps\": [],\n    \"urls\": [],\n    \"user_mentions\": []\n  },\n  \"user_info\": {\n    \"screen_name\": \"MitchellZe19163\",\n    \"name\": \"Caden Somerset\",\n    \"created_at\": \"Sun Feb 25 02:50:52 +0000 2024\",\n    \"description\": null,\n    \"rest_id\": \"1761584467209269248\",\n    \"followers_count\": 14,\n    \"favorites_count\": 56,\n    \"avatar\": \"https://pbs.twimg.com/profile_images/2074767376780771328/iq2sV-zK_normal.jpg\",\n    \"url\": null,\n    \"cover_image\": null,\n    \"verified_type\": null,\n    \"verified\": false,\n    \"friends_count\": null,\n    \"location\": \"Miami, US\"\n  },\n  \"media\": [],\n  \"quoted\": {\n    \"tweet_id\": \"2087094814651064763\",\n    \"bookmarks\": 0,\n    \"created_at\": \"Tue Aug 11 08:32:34 +0000 2026\",\n    \"favorites\": 8,\n    \"text\": \"BREAKING: 🇨🇦CANADA IS QUIETLY ONE OF THE BIGGEST MINING POWERS ON EARTH\\n\\nThe world’s top miners are now worth about $2.17T, and Canada alone represents roughly $415B across 11 companies in @mining .com latest Top 50 breakdown\\n\\nNames to know:\\n\\n$AEM - Agnico Eagle\\n$B - Barrick https://t.co/T2IOFTNvsr\",\n    \"lang\": \"en\",\n    \"views\": \"718\",\n    \"quotes\": 8,\n    \"sensitive\": false,\n    \"replies\": 0,\n    \"retweets\": 1,\n    \"conversation_id\": \"2087094814651064763\",\n    \"author\": {\n      \"rest_id\": \"1729611090471112704\",\n      \"created_at\": \"Tue Nov 28 21:19:54 +0000 2023\",\n      \"name\": \"TradePulse\",\n      \"screen_name\": \"TradePulse2\",\n      \"avatar\": \"https://pbs.twimg.com/profile_images/1975466085513134080/P0cxN_DD_normal.jpg\",\n      \"blue_verified\": true\n    },\n    \"media\": {\n      \"photo\": [\n        {\n          \"media_url_https\": \"https://pbs.twimg.com/media/HPbZdrwX0AA-DDZ.jpg\",\n          \"id\": \"2087094581317849088\",\n          \"sizes\": {\n            \"h\": 1600,\n            \"w\": 1291\n          }\n        }\n      ]\n    }\n  }\n},\n{\n  \"type\": \"tweet\",\n  \"tweet_id\": \"2087099372777468030\",\n  \"screen_name\": \"SuhailAhmad\",\n  \"bookmarks\": 0,\n  \"favorites\": 1,\n  \"created_at\": \"Tue Aug 11 08:50:41 +0000 2026\",\n  \"text\": \"Watch this short two-minute clip of Nvidia $NVDA CEO Jensen Huang below.\\n\\nHe outlines why the chipmaker is moving beyond just selling GPUs to financing the greatest infrastructure buildout in human history.\\n\\nIt was quite a sight to see top finance 'bros' sharing a table with Jensen Huang, the driving force behind modern AI.\\n\\nNvidia announced it is teaming up with private capital heavyweights including Apollo, Blackstone, BlackRock, Brookfield, Goldman Sachs, and KKR. \\n\\nThe goal is to mobilize private capital to fund the chips, data centers, and power grids required for the AI expansion. \\n\\nIt's evidence that the capital requirements of AI infrastructure have outgrown traditional tech balance sheets.\\n\\nMorgan Stanley estimates hyperscalers will spend $3.5 trillion between 2026 and 2028.\\n\\nApollo expects total AI infrastructure spending could eventually top $8 trillion.\\n\\nCorporate cash flows alone cannot cover a expansion of this size.\\n\\nTech companies are turning to private credit, corporate bonds, securitization, project finance, and equity. \\n\\nNvidia is stepping into this gap directly. \\n\\nIt is now actively helping customers finance the physical setups needed to deploy its hardware, offering financial backing and debt guarantees.\\n\\nFor example, Nvidia is discussing a financial guarantee for a 10-gigawatt Ohio data center project leased to OpenAI. \\n\\nNvidia is absorbing some of the financing risk so its key customers can secure massive compute capacity. \\n\\nThis playbook does introduce concentrated risk.\\n\\nFinancing the very customers that buy your chips creates circular financing dynamics that are concerning. But the tech industry is adamant, the demand is there and we can't build fast enough.\\n\\nHowever, if underlying software revenue lags, financial risk ripples through the supplier and the buyer simultaneously.\\n\\nPartnering with asset managers unlocks capital for the infrastructure boom, but it ties Nvidia’s growth to the balance sheets of its customers.\\n\\nAs an Nvidia shareholder, I'm cautiously optimistic. \\n\\nShares are up almost 10x over the past five years and the best years are behind it but may still deliver above market returns for the next five years as becomes the lynchpin of the AI buildout.\\n\\nLove to hear from Nvidia shareholders, what are your thoughts? \\n\\nVideo source: CNBC\",\n  \"lang\": \"en\",\n  \"display_text_range\": [\n    0,\n    275\n  ],\n  \"source\": \"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\n  \"quotes\": 0,\n  \"sensitive\": false,\n  \"replies\": 0,\n  \"conversation_id\": \"2087099372777468030\",\n  \"retweets\": 1,\n  \"views\": \"12\",\n  \"entities\": {\n    \"hashtags\": [],\n    \"symbols\": [\n      {\n        \"indices\": [\n          43,\n          48\n        ],\n        \"tag\": {\n          \"info\": {\n            \"info\": {\n              \"name\": \"NVIDIA Corp\",\n              \"ticker\": \"NVDA\"\n            }\n          }\n        },\n        \"text\": \"NVDA\"\n      }\n    ],\n    \"timestamps\": [],\n    \"urls\": [],\n    \"user_mentions\": []\n  },\n  \"user_info\": {\n    \"screen_name\": \"SuhailAhmad\",\n    \"name\": \"Suhail Ahmad\",\n    \"created_at\": \"Mon Apr 20 21:25:20 +0000 2009\",\n    \"description\": null,\n    \"rest_id\": \"33669950\",\n    \"followers_count\": 2174,\n    \"favorites_count\": 4485,\n    \"avatar\": \"https://pbs.twimg.com/profile_images/2065728721898672129/ep_VNr8h_normal.jpg\",\n    \"url\": null,\n    \"cover_image\": null,\n    \"verified_type\": null,\n    \"verified\": true,\n    \"friends_count\": null,\n    \"location\": \"Canada / UK\"\n  },\n  \"media\": {\n    \"video\": [\n      {\n        \"media_url_https\": \"https://pbs.twimg.com/amplify_video_thumb/2087099250563764224/img/YavHN_qR7np1PWdy.jpg\",\n        \"variants\": [\n          {\n            \"content_type\": \"application/x-mpegURL\",\n            \"url\": \"https://video.twimg.com/amplify_video/2087099250563764224/pl/lFcP6vxl-H48qu9m.m3u8?tag=29\"\n          },\n          {\n            \"bitrate\": 256000,\n            \"content_type\": \"video/mp4\",\n            \"url\": \"https://video.twimg.com/amplify_video/2087099250563764224/vid/avc1/438x270/L-2wMmmi5Rawo0Nb.mp4?tag=29\"\n          },\n          {\n            \"bitrate\": 832000,\n            \"content_type\": \"video/mp4\",\n            \"url\": \"https://video.twimg.com/amplify_video/2087099250563764224/vid/avc1/584x360/xLXxf_NlcSMhMQyx.mp4?tag=29\"\n          },\n          {\n            \"bitrate\": 2176000,\n            \"content_type\": \"video/mp4\",\n            \"url\": \"https://video.twimg.com/amplify_video/2087099250563764224/vid/avc1/938x578/8pwihHwUluBSzDOV.mp4?tag=29\"\n          }\n        ],\n        \"aspect_ratio\": [\n          469,\n          289\n        ],\n        \"duration\": 118931,\n        \"original_info\": {\n          \"focus_rects\": [],\n          \"height\": 578,\n          \"width\": 938\n        },\n        \"id\": \"2087099250563764224\"\n      }\n    ]\n  }\n},\n{\n  \"type\": \"tweet\",\n  \"tweet_id\": \"2087099367119274389\",\n  \"screen_name\": \"FinanceCompass_\",\n  \"bookmarks\": 0,\n  \"favorites\": 0,\n  \"created_at\": \"Tue Aug 11 08:50:", "truncated": true, "ts": "2026-08-11T08:52:02.990246+00:00"}
